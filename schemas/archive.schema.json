{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csully1234/Beverage-Family/archive.schema.json",
  "title": "Beverage historical archive v1",
  "type": "object",
  "required": [
    "archive_sources",
    "places",
    "place_links"
  ],
  "properties": {
    "archive_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "place_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place_link"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "short_title",
        "date",
        "date_precision",
        "source_type",
        "repository",
        "collection",
        "url",
        "citation",
        "excerpt",
        "summary",
        "people_ids",
        "place_ids",
        "event_ids",
        "evidence_level",
        "notes",
        "conflicts",
        "accessed",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "date_precision": {
          "enum": [
            "exact",
            "month",
            "year",
            "approximate",
            "unknown"
          ]
        },
        "source_type": {
          "enum": [
            "legislative_journal",
            "town_history",
            "manuscript",
            "newspaper",
            "obituary",
            "institutional_biography",
            "catalog",
            "military_record",
            "probate",
            "deed",
            "government_record",
            "vital_record",
            "cemetery_transcription",
            "cemetery_index",
            "geographic_reference",
            "institutional_history"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "people_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "place_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "evidence_level": {
          "enum": [
            "verified",
            "strongly_supported",
            "corroboration"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "provenance": {
          "type": "object",
          "required": [
            "origin"
          ],
          "properties": {
            "origin": {
              "type": "string",
              "minLength": 1
            },
            "base_commit": {
              "type": "string",
              "minLength": 1
            },
            "legacy_url": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "required": [
        "id",
        "name",
        "alternate_names",
        "type",
        "latitude",
        "longitude",
        "parent_place_id",
        "historical_notes",
        "date_from",
        "date_to",
        "confidence",
        "sources",
        "public",
        "coordinate_precision",
        "coordinate_source_id",
        "coordinate_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "alternate_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "type": {
          "enum": [
            "municipality",
            "harbor",
            "cemetery",
            "country",
            "region",
            "institution",
            "public_site"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -85,
          "maximum": 85
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "parent_place_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "historical_notes": {
          "type": "string",
          "minLength": 1
        },
        "date_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "date_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "public": {
          "const": true
        },
        "coordinate_precision": {
          "enum": [
            "municipality",
            "harbor",
            "country",
            "region",
            "approximate_site",
            "site",
            "unlocated"
          ]
        },
        "coordinate_source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "coordinate_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "place_link": {
      "type": "object",
      "required": [
        "id",
        "subject_type",
        "subject_id",
        "place_id",
        "relation",
        "category",
        "date_from",
        "date_to",
        "date_precision",
        "source_ids",
        "summary",
        "evidence_level",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "subject_type": {
          "enum": [
            "person",
            "event"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "place_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "relation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "category": {
          "enum": [
            "civic",
            "legal",
            "historical_writing",
            "infrastructure",
            "engineering",
            "education",
            "occupation",
            "military",
            "community",
            "religion",
            "birth",
            "burial",
            "migration",
            "maritime"
          ]
        },
        "date_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "date_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "date_precision": {
          "enum": [
            "exact",
            "month",
            "year",
            "approximate",
            "unknown"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_level": {
          "enum": [
            "verified",
            "strongly_supported",
            "corroboration"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
